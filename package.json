{
  "name": "log-ingestion-service",
  "version": "1.0.0",
  "description": "High-performance log ingestion and query service",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
  "dev": "tsx watch src/server.ts",
  "build": "tsc",
  "start": "node dist/server.js",
  "typecheck": "tsc --noEmit",
  "test": "vitest run",
  "test:watch": "vitest"
},
  "keywords": [
    "typescript",
    "postgresql",
    "logs",
    "docker"
  ],
  "author": "Saeb Alawneh",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
